NODE_ENV=production
PORT=3000

# Có thể bỏ trống hai biến này trên Railway nếu dịch vụ đã có Public Domain.
# Ứng dụng sẽ tự dùng https://$RAILWAY_PUBLIC_DOMAIN.
PUBLIC_BASE_URL=
MINI_APP_URL=

TELEGRAM_BOT_TOKEN=replace_with_new_bot_token
# Danh sách ID số, phân tách bằng dấu phẩy. Không nhập @username.
TELEGRAM_MANAGER_IDS=123456789
TELEGRAM_WEBHOOK_SECRET=replace_with_long_random_secret

# Railway MongoDB: đặt giá trị tham chiếu là ${{MongoDB.MONGO_URL}}
MONGODB_URI=

ALLOW_DEV_TELEGRAM_BYPASS=false
AUTO_SET_WEBHOOK=true
ORDERS_ENABLED=false

# Tùy chọn. Thời gian một chuỗi Telegram initData còn được chấp nhận (giây).
# Mặc định 600. Càng ngắn thì initData rò rỉ càng ít giá trị với kẻ tấn công.
INIT_DATA_MAX_AGE_SECONDS=600

# Tùy chọn: debug | info | warn | error. Mặc định info.
LOG_LEVEL=info
